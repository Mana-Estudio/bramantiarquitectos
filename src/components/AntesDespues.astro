---
// Slider antes/después. Usa un <input type="range"> nativo: funciona con teclado (flechas, Inicio, Fin)
// y táctil sin código extra. Sin JS se muestran las dos fotos lado a lado.
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';
import type { Idioma } from '../lib/sitio';

interface Par {
  antes: ImageMetadata;
  antesAlt: string;
  despues: ImageMetadata;
  despuesAlt: string;
  estancia: string;
}
interface Props {
  pares: Par[];
  extra?: { src: ImageMetadata; alt: string }[];
  idioma?: Idioma;
}
const { pares, extra = [], idioma = 'es' } = Astro.props;
const es = idioma === 'es';
const ESTANCIAS: Record<string, [string, string]> = {
  salon: ['Salón', 'Living room'],
  cocina: ['Cocina', 'Kitchen'],
  bano: ['Baño', 'Bathroom'],
  dormitorio: ['Dormitorio', 'Bedroom'],
  pasillo: ['Pasillo', 'Hallway'],
  comedor: ['Comedor', 'Dining room'],
  terraza: ['Terraza', 'Terrace'],
  almacenaje: ['Almacenaje', 'Storage'],
  detalle: ['Vivienda', 'Home'],
};
const nombre = (e: string) => (ESTANCIAS[e] ?? ESTANCIAS.detalle)[es ? 0 : 1];
---

{(pares.length > 0 || extra.length > 0) && (
  <section class="seccion fondo-lino antes-despues" aria-labelledby="antes-despues-titulo">
    <div class="contenedor">
      <header class="ad-cabecera">
        <p class="etiqueta">{es ? 'La transformación' : 'The transformation'}</p>
        <h2 id="antes-despues-titulo">{es ? <>Antes <em>y después.</em></> : <>Before <em>and after.</em></>}</h2>
        {pares.length > 0 && <p class="secundario">{es ? 'Desliza para comparar el estado previo con el resultado.' : 'Slide to compare the original state with the result.'}</p>}
      </header>

      <div class="ad-lista">
        {pares.map((p, i) => (
          <figure class="comparador" data-comparador>
            <div class="comparador-marco">
              <div class="comparador-capa capa-antes">
                <Foto src={p.antes} alt={p.antesAlt} sizes="(min-width: 60rem) 70vw, 100vw" anchos={[640, 960, 1400]} />
                <span class="comparador-rotulo">{es ? 'Antes' : 'Before'}</span>
              </div>
              <div class="comparador-capa capa-despues">
                <Foto src={p.despues} alt={p.despuesAlt} sizes="(min-width: 60rem) 70vw, 100vw" anchos={[640, 960, 1400]} />
                <span class="comparador-rotulo rotulo-despues">{es ? 'Después' : 'After'}</span>
              </div>
              <span class="comparador-linea" aria-hidden="true"></span>
              <input
                type="range"
                min="0"
                max="100"
                value="50"
                class="comparador-control"
                aria-label={`${es ? 'Comparar antes y después' : 'Compare before and after'}: ${nombre(p.estancia)} ${pares.length > 1 ? i + 1 : ''}`.trim()}
                aria-valuetext={es ? '50 % del resultado visible' : '50% of the result visible'}
                data-texto={es ? '% del resultado visible' : '% of the result visible'}
              />
            </div>
            <figcaption class="secundario">{nombre(p.estancia)}</figcaption>
          </figure>
        ))}
      </div>

      {extra.length > 0 && (
        <div class="estado-previo">
          <h3 class="etiqueta sin-linea">{es ? 'Estado previo' : 'Original state'}</h3>
          <ul role="list">
            {extra.map((f) => (
              <li class="foto">
                <Foto src={f.src} alt={f.alt} sizes="(min-width: 60rem) 25vw, 50vw" anchos={[320, 640]} />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<script>
  import '../scripts/antes-despues';
</script>

<style>
  .ad-cabecera {
    display: grid;
    gap: var(--espacio-s);
    margin-bottom: var(--espacio-xl);
    max-width: 40rem;
  }
  .ad-cabecera h2 {
    font-size: var(--paso-5);
  }
  .ad-lista {
    display: grid;
    gap: var(--espacio-xl);
  }
  .comparador {
    display: grid;
    gap: var(--espacio-xs);
  }
  /* Sin JS: dos fotos lado a lado. */
  .comparador-marco {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--separacion);
  }
  .comparador-capa {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--piedra);
  }
  .comparador-capa :global(picture),
  .comparador-capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comparador-rotulo {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--piedra);
    font-size: var(--paso--2);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .comparador-control,
  .comparador-linea {
    display: none;
  }

  /* Con JS: superpuestas y recortadas con clip-path. */
  .comparador.activo .comparador-marco {
    display: block;
    aspect-ratio: 3 / 2;
    max-height: 80vh;
    overflow: hidden;
    --pos: 50%;
  }
  .comparador.activo .comparador-capa {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }
  .comparador.activo .capa-despues {
    clip-path: inset(0 0 0 var(--pos));
  }
  .comparador.activo .rotulo-despues {
    left: auto;
    right: 0.75rem;
  }
  .comparador.activo .comparador-linea {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--piedra);
    pointer-events: none;
  }
  .comparador.activo .comparador-linea::after {
    content: '↔';
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--piedra);
    color: var(--tinta);
    font-size: 1.1rem;
  }
  .comparador.activo .comparador-control {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .comparador.activo .comparador-control:focus-visible + * {
    outline: none;
  }
  .comparador.activo:has(.comparador-control:focus-visible) .comparador-marco {
    outline: 2px solid var(--tinta);
    outline-offset: 4px;
  }

  .estado-previo {
    margin-top: var(--espacio-xl);
    display: grid;
    gap: var(--espacio-s);
  }
  .estado-previo ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--separacion);
  }
  .estado-previo li {
    aspect-ratio: 1;
  }
  @media (min-width: 60rem) {
    .ad-lista {
      grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));
    }
  }
</style>
