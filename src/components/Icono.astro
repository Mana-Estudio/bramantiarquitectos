---
// Pocos íconos funcionales, de trazo fino. Siempre decorativos (aria-hidden): el texto va al lado.
interface Props {
  nombre: 'whatsapp' | 'telefono' | 'correo' | 'mapa' | 'flecha' | 'cerrar' | 'menu' | 'anterior' | 'siguiente' | 'mas';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---

<svg class={clase} viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {nombre === 'whatsapp' && (
    <>
      <path d="M4.5 19.5l1.1-3.9A8 8 0 1 1 8.6 18.5z" />
      <path d="M9.2 8.6c.3-.6.6-.6.9-.6h.6c.2 0 .4.1.5.4l.7 1.7c.1.3 0 .5-.1.7l-.5.6c-.1.2-.1.4 0 .6.7 1.2 1.6 2 2.8 2.6.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.7-.1l1.6.8c.3.1.4.3.4.5 0 .6-.3 1.4-1.1 1.8-.8.4-1.9.4-3.4-.3a9.6 9.6 0 0 1-4-3.6c-.8-1.3-.9-2.6-.3-3.8z" />
    </>
  )}
  {nombre === 'telefono' && <path d="M5 4h3.5l1.5 4-2 1.2a11 11 0 0 0 6.8 6.8L16 14l4 1.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z" />}
  {nombre === 'correo' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="M3.5 6l8.5 7 8.5-7" />
    </>
  )}
  {nombre === 'mapa' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nombre === 'siguiente' && <path d="M9 5l7 7-7 7" />}
  {nombre === 'anterior' && <path d="M15 5l-7 7 7 7" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nombre === 'menu' && <path d="M4 8h16M4 16h16" />}
  {nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
</svg>
