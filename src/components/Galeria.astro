---
// Galería con lightbox accesible (<dialog>, teclado, swipe). Sin JS, cada foto enlaza a su versión grande.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import type { Idioma } from '../lib/sitio';

interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
  titulo: string;
  idioma?: Idioma;
  id?: string;
}
const { fotos, titulo, idioma = 'es', id = 'galeria' } = Astro.props;
const es = idioma === 'es';
const grandes = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: Math.min(f.src.width, 1800), format: 'webp', quality: 78 })));
---

{fotos.length > 0 && (
  <section class="seccion galeria" aria-labelledby={`${id}-titulo`} data-galeria>
    <div class="contenedor">
      <header class="galeria-cabecera">
        <p class="etiqueta">{es ? 'Galería' : 'Gallery'}</p>
        <h2 id={`${id}-titulo`}>{titulo}</h2>
      </header>
      <ul role="list" class="galeria-lista">
        {fotos.map((f, i) => (
          <li class:list={[{ ancha: f.src.width > f.src.height * 1.2 }]}>
            <a href={grandes[i].src} class="foto galeria-item" data-indice={i} data-grande={grandes[i].src} aria-label={`${es ? 'Ampliar foto' : 'Enlarge photo'} ${i + 1}: ${f.alt}`}>
              <Foto src={f.src} alt={f.alt} sizes="(min-width: 60rem) 40vw, (min-width: 40rem) 50vw, 100vw" anchos={[480, 800, 1200]} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <dialog class="lightbox" data-lightbox aria-label={es ? 'Visor de fotos' : 'Photo viewer'}>
      <figure>
        <img data-lightbox-img alt="" decoding="async" />
        <figcaption>
          <span data-lightbox-texto></span>
          <span class="lightbox-contador" data-lightbox-contador></span>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-boton lightbox-cerrar" data-cerrar>
        <Icono nombre="cerrar" /><span class="visualmente-oculto">{es ? 'Cerrar' : 'Close'}</span>
      </button>
      <button type="button" class="lightbox-boton lightbox-anterior" data-anterior>
        <Icono nombre="anterior" /><span class="visualmente-oculto">{es ? 'Foto anterior' : 'Previous photo'}</span>
      </button>
      <button type="button" class="lightbox-boton lightbox-siguiente" data-siguiente>
        <Icono nombre="siguiente" /><span class="visualmente-oculto">{es ? 'Foto siguiente' : 'Next photo'}</span>
      </button>
    </dialog>
  </section>
)}

<script>
  import '../scripts/lightbox';
</script>

<style>
  .galeria-cabecera {
    display: grid;
    gap: var(--espacio-s);
    margin-bottom: var(--espacio-xl);
  }
  .galeria-cabecera h2 {
    font-size: var(--paso-5);
  }
  .galeria-lista {
    display: grid;
    gap: var(--separacion);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
  }
  .galeria-lista li {
    grid-column: span 1;
  }
  .galeria-lista li.ancha {
    grid-column: span 2;
  }
  .galeria-item {
    display: block;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }
  .ancha .galeria-item {
    aspect-ratio: 3 / 2;
  }
  @media (min-width: 60rem) {
    .galeria-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 18 16 / 0.97);
    color: var(--piedra);
  }
  .lightbox::backdrop {
    background: rgb(20 18 16 / 0.97);
  }
  .lightbox figure {
    position: absolute;
    inset: 4.5rem var(--margen) 4.5rem;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
    touch-action: pan-y;
  }
  .lightbox figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--paso--1);
    color: #d8d1c6;
  }
  .lightbox-contador {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lightbox-boton {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(244 241 236 / 0.35);
    border-radius: 50%;
    background: transparent;
    color: var(--piedra);
  }
  .lightbox-boton:hover {
    background: rgb(244 241 236 / 0.12);
  }
  .lightbox-boton:focus-visible {
    outline-color: var(--piedra);
  }
  .lightbox-cerrar {
    top: 1rem;
    right: var(--margen);
  }
  .lightbox-anterior,
  .lightbox-siguiente {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-anterior {
    left: 0.75rem;
  }
  .lightbox-siguiente {
    right: 0.75rem;
  }
  @media (max-width: 40rem) {
    .lightbox-anterior,
    .lightbox-siguiente {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
    .lightbox-anterior {
      left: var(--margen);
    }
    .lightbox-siguiente {
      right: var(--margen);
    }
  }
</style>
