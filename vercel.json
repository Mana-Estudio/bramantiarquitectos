      "statusCode": 301
    },
    {
      "source": "/category/:ruta*",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/domotica-en-el-diseno-arquitectonico-integrando-tecnologia-para-un-hogar-inteligente-con-atmosphere-arquitectos/",
      "destination": "/domotica-en-el-diseno-arquitectonico-integrando-tecnologia-para-un-hogar-inteligente/",
