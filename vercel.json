{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com; media-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/casa-felipe-ii/",
      "destination": "/nuestras-creaciones/casa-felipe-ii-reforma-integral-retiro-madrid/",
      "statusCode": 301
    },
    {
      "source": "/casa-felipe-ii",
      "destination": "/nuestras-creaciones/casa-felipe-ii-reforma-integral-retiro-madrid/",
      "statusCode": 301
    },
    {
      "source": "/nuestras-creaciones/casa-werlyb/",
      "destination": "/nuestras-creaciones/casa-werlyb-reforma-integral-madrid/",
      "statusCode": 301
    },
    {
      "source": "/nuestras-creaciones/casa-werlyb",
      "destination": "/nuestras-creaciones/casa-werlyb-reforma-integral-madrid/",
      "statusCode": 301
    },
    {
      "source": "/estudio/",
      "destination": "/estudio-arquitectura-madrid/",
      "statusCode": 301
    },
    {
      "source": "/estudio",
      "destination": "/estudio-arquitectura-madrid/",
      "statusCode": 301
    },
    {
      "source": "/tu-reforma-integral-en-madrid/",
      "destination": "/reformas-integrales-madrid/",
      "statusCode": 301
    },
    {
      "source": "/tu-reforma-integral-en-madrid",
      "destination": "/reformas-integrales-madrid/",
      "statusCode": 301
    },
    {
      "source": "/arquitectos-en-madrid/",
      "destination": "/estudio-arquitectura-madrid/",
      "statusCode": 301
    },
    {
      "source": "/arquitectos-en-madrid",
      "destination": "/estudio-arquitectura-madrid/",
      "statusCode": 301
    },
    {
      "source": "/landing-los-satelites/",
      "destination": "/ventapromocionlossatelites/",
      "statusCode": 301
    },
    {
      "source": "/landing-los-satelites",
